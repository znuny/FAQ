msgid "external (customer)"
msgstr "esterno (cliente)"

#. SysConfig
msgid "internal (agent)"
msgstr "interno (agente)"

#. SysConfig
msgid "public (all)"
msgstr "pubblico (tutti)"

#. SysConfig
msgid "public (public)"
msgstr "pubblico (pubblico)"

#. SysConfig
msgid "Agent FAQ Related Articles"
msgstr "Articoli FAQ correlati agente"

#. SysConfig
msgid "Agent FAQ Related Articles."
msgstr "Articoli FAQ correlati agente."

#. SysConfig
msgid "Below body"
msgstr "Sotto il corpo"

#. SysConfig
msgid "Below subject"
msgstr "Sotto l'oggetto"

#. SysConfig
msgid "Customer user attribute to check its group relation."
msgstr "Attributo utente cliente per verificare la relazione di gruppo."

#. SysConfig
msgid "Defines the position where the related FAQ articles widget is located."
msgstr ""
"Definisce la posizione in cui si trova il widget degli articoli FAQ "
"correlati."

#. SysConfig
msgid "Enable customer group support permissions."
msgstr "Abilita i permessi di supporto dei gruppi clienti."

#. SysConfig
msgid "Enable customer user permission attributes."
msgstr "Abilita gli attributi di permesso degli utenti clienti."

#. SysConfig
msgid "Enable the related article feature for the agent frontend."
msgstr "Abilita la funzione articoli correlati per il frontend agente."

#. SysConfig
msgid "Generate HTML comment hooks for the specified blocks so that filters can use them."
msgstr ""
"Genera ganci di commento HTML per i blocchi specificati in modo che i "
"filtri possano utilizzarli."

#. SysConfig
msgid "Group to which customer users belong by default (if this setting is enabled)."
msgstr ""
"Gruppo a cui appartengono gli utenti clienti per impostazione "
"predefinita (se questa impostazione è abilitata)."

#. SysConfig
msgid "Mapping between customer user attribute value and group."
msgstr "Mappatura tra valore attributo utente cliente e gruppo."

#. SysConfig
msgid "Show the stars for the articles with a rating equal or greater like the defined value if enabled."
msgstr ""
"Mostra le stelle per gli articoli con una valutazione uguale o "
"superiore al valore definito, se abilitato."

